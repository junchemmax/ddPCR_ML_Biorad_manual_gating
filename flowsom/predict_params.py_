"""
Predict best FlowSOM parameters (XDIM, YDIM, RLEN) for a new ddPCR dataset
using the supervised model trained by train_param_predictor.py.

Usage:
    python predict_params.py  <path/to/data_folder>

The data folder should contain per-well *_Amplitude.csv files (same format as
the training data).  The script prints the predicted parameters and optionally
launches optimize_flowsom_params.py with those values as warm-start hints.
"""
from __future__ import annotations

import glob
import os
import sys
import warnings

warnings.filterwarnings("ignore", category=FutureWarning)

import flowsom_rs
import joblib
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from scipy.signal import find_peaks
from scipy.spatial.distance import pdist, squareform
from scipy.stats import gaussian_kde, kurtosis, skew
from sklearn.cluster import AgglomerativeClustering

HERE      = os.path.dirname(os.path.abspath(__file__))
MODEL_PKL = os.path.join(HERE, "param_predictor.pkl")
SEED      = 42


# ── Feature extraction (must match optimize_flowsom_rs_params_single.py) ─────────
def _kde_peak_info(vals: np.ndarray) -> tuple[int, np.ndarray]:
    """Return (n_peaks, peak_positions_array) from KDE."""
    kde = gaussian_kde(vals, bw_method=0.15)
    xs = np.linspace(vals.min(), vals.max(), 500)
    density = kde(xs)
    peaks, _ = find_peaks(density, prominence=density.max() * 0.05)
    return len(peaks), xs[peaks]


def extract_features(data: np.ndarray) -> dict:
    feat: dict = {}
    feat["n_droplets"] = len(data)
    _peak_counts: list = []
    for i, ch in enumerate(["ch1", "ch2"]):
        vals = data[:, i]
        mu    = float(np.mean(vals))
        sigma = float(np.std(vals))
        p25   = float(np.percentile(vals, 25))
        p75   = float(np.percentile(vals, 75))
        feat[f"{ch}_std"]    = sigma
        feat[f"{ch}_iqr"]    = p75 - p25
        feat[f"{ch}_cv"]     = sigma / (mu + 1e-9)
        feat[f"{ch}_skew"]   = float(skew(vals))
        feat[f"{ch}_kurt"]   = float(kurtosis(vals))
        feat[f"{ch}_bimodality"] = (feat[f"{ch}_skew"] ** 2 + 1) / (feat[f"{ch}_kurt"] + 3 + 1e-9)
        log_vals = np.log1p(np.clip(vals, 0, None))
        feat[f"{ch}_log_std"]  = float(np.std(log_vals))
        feat[f"{ch}_log_skew"] = float(skew(log_vals))
        feat[f"{ch}_outlier_frac"] = float(np.mean((vals < mu - 3 * sigma) | (vals > mu + 3 * sigma)))
        n_peaks, pos = _kde_peak_info(vals)
        feat[f"{ch}_kde_peaks"] = n_peaks
        feat[f"{ch}_peak_separation"] = float(
            (pos[-1] - pos[0]) / (sigma + 1e-9) if n_peaks >= 2 else 0.0
        )
        # Rain fraction: droplets in valley between peaks — blurry boundary → larger rlen
        feat[f"{ch}_rain_frac"] = float(
            np.mean((vals > pos[0]) & (vals < pos[-1])) if n_peaks >= 2 else 0.0
        )
        _peak_counts.append(n_peaks)
    feat["ch1_ch2_corr"] = float(np.corrcoef(data[:, 0], data[:, 1])[0, 1])
    feat["kde_peaks_product"] = _peak_counts[0] * _peak_counts[1]
    feat["joint_spread"] = float(np.sqrt(
        max(0.0, np.var(data[:, 0]) * np.var(data[:, 1]) * (1.0 - feat["ch1_ch2_corr"] ** 2))
    ))
    # Aspect ratio of 2D cloud — elongated cloud may justify asymmetric xdim/ydim
    feat["ch_std_ratio"] = feat["ch1_std"] / (feat["ch2_std"] + 1e-9)
    return feat


# ── Load data ──────────────────────────────────────────────────────────────────
if len(sys.argv) < 2:
    print("Usage: python predict_params.py <path/to/data_folder>")
    sys.exit(1)

data_dir  = sys.argv[1]
csv_files = sorted(glob.glob(os.path.join(data_dir, "*.csv")))
if not csv_files:
    print(f"No CSV files found in: {data_dir}")
    sys.exit(1)

print(f"Found {len(csv_files)} CSV file(s) in: {data_dir}")

# ── Load model ─────────────────────────────────────────────────────────────────
if not os.path.exists(MODEL_PKL):
    print(
        f"\nModel not found: {MODEL_PKL}\n"
        "Train it first:\n"
        "  1. Run optimize_flowsom_params.py on several datasets to build meta_dataset.csv\n"
        "  2. Run train_param_predictor.py\n"
    )
    sys.exit(1)

bundle           = joblib.load(MODEL_PKL)
cluster_pipeline = bundle["cluster_pipeline"]
grid_pipeline    = bundle["grid_pipeline"]
feature_cols     = bundle["feature_cols"]


def round_even(v: float) -> int:
    i = int(round(v))
    return i if i % 2 == 0 else i + 1


def _run_flowsom(data: np.ndarray, xdim: int, ydim: int, rlen: int, n_clusters: int, seed: int = SEED):
    """Train SOM + metacluster; return (node_meta, bmu_idx)."""
    n_nodes    = xdim * ydim
    grid       = [(x, y) for x in range(xdim) for y in range(ydim)]
    nhbrdist   = squareform(pdist(grid, metric="chebyshev"))
    radii      = (np.quantile(nhbrdist, 0.67), 0.0)
    codes_init = data[np.random.default_rng(seed).choice(len(data), n_nodes, replace=False)]

    codes, bmu_idx, _ = flowsom_rs.train_batch_som(data, codes_init, nhbrdist, radii, rlen=rlen)
    node_meta = AgglomerativeClustering(
        n_clusters=n_clusters, linkage="average"
    ).fit_predict(codes)
    return node_meta, bmu_idx


def _save_cluster_png(data: np.ndarray, metacluster: np.ndarray, out_png: str, csv_name: str,
                       xdim: int, ydim: int, rlen: int, n_clusters: int) -> None:
    """Save a scatter plot colored by predicted metacluster (no Optuna trial ranking)."""
    max_pts   = 200_000
    plot_idx  = np.random.default_rng(0).choice(len(data), min(max_pts, len(data)), replace=False)
    plot_idx.sort()
    X       = data[plot_idx]
    mc_plot = metacluster[plot_idx]

    plt.close("all")
    fig, ax = plt.subplots(figsize=(6, 5), facecolor="white")
    ax.set_facecolor("white")
    for mc in sorted(np.unique(mc_plot)):
        mask = mc_plot == mc
        ax.scatter(X[mask, 1], X[mask, 0], s=5, alpha=0.6, label=f"MC{mc}")
    ax.set_xlabel("Ch2Amplitude")
    ax.set_ylabel("Ch1Amplitude")
    ax.legend(markerscale=8, title="Metacluster")
    ax.set_title(f"FlowSOM (predicted params) \u2013 {csv_name}  {len(data):,} droplets")
    param_text = f"xdim={xdim}  ydim={ydim}  rlen={rlen}  nc={n_clusters}  (predicted, not optimised)"
    ax.text(0.01, 0.01, param_text, transform=ax.transAxes, fontsize=7,
            verticalalignment="bottom", color="gray", family="monospace")
    fig.tight_layout()
    fig.savefig(out_png, dpi=150, facecolor="white", bbox_inches="tight")
    plt.close(fig)


# ── Predict per well (matches how each training row was built) ────────────────
for f in csv_files:
    df   = pd.read_csv(f, skiprows=3)[["Ch1Amplitude", "Ch2Amplitude"]].dropna()
    data = df.values.astype(np.float64)

    print(f"\n{'=' * 70}")
    print(f"{os.path.basename(f)}  ({len(data):,} droplets)")
    print(f"{'=' * 70}")

    features = extract_features(data)
    X_new    = np.array([[features[c] for c in feature_cols]])

    nclust_pred = max(1, int(cluster_pipeline.predict(X_new)[0]))

    print("── Predicted FlowSOM parameters ──────────────────")
    print(f"  N_CLUSTERS = {nclust_pred}")
    if nclust_pred == 1:
        print("  (single-cluster predicted; XDIM/YDIM/RLEN grid is not applicable)")
        metacluster = np.ones(len(data), dtype=int)
        xdim_pred = ydim_pred = rlen_pred = None
    else:
        grid_pred = grid_pipeline.predict(X_new)[0]
        xdim_pred = round_even(grid_pred[0])
        ydim_pred = round_even(grid_pred[1])
        rlen_pred = max(5, int(round(grid_pred[2])))
        print(f"  XDIM = {xdim_pred}")
        print(f"  YDIM = {ydim_pred}")
        print(f"  RLEN = {rlen_pred}")
        node_meta, bmu_idx = _run_flowsom(data, xdim_pred, ydim_pred, rlen_pred, nclust_pred)
        metacluster = node_meta[bmu_idx] + 1
    print("──────────────────────────────────────────────────")

    csv_stem = os.path.splitext(os.path.basename(f))[0]
    out_dir  = os.path.join(os.path.dirname(f), "output")
    os.makedirs(out_dir, exist_ok=True)
    tag     = f"_pred_nc{nclust_pred}" if xdim_pred is None else f"_pred_xdim{xdim_pred}_ydim{ydim_pred}_rlen{rlen_pred}_nc{nclust_pred}"
    out_png = os.path.join(out_dir, f"{csv_stem}_clusters{tag}.png")
    _save_cluster_png(
        data, metacluster, out_png, os.path.basename(f),
        xdim_pred or 0, ydim_pred or 0, rlen_pred or 0, nclust_pred,
    )
    print(f"Saved predicted-cluster plot → {out_png}")

print("\nCopy these values into run_ddpcr_flowsom_flowsom_rs.py, or")
print("use them as starting point for optimize_flowsom_params.py (one file at a time).")

# ── Raw confidence hint ────────────────────────────────────────────────────────
meta_csv = os.path.join(HERE, "output", "meta_dataset.csv")
if os.path.exists(meta_csv):
    n_train = len(pd.read_csv(meta_csv))
    if n_train < 10:
        print(
            f"\nNote: model was trained on only {n_train} dataset(s). "
            "Predictions are rough estimates — verify with Optuna optimisation."
        )
    else:
        print(f"\n(Model trained on {n_train} datasets.)")

