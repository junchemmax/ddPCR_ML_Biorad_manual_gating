"""
Train a supervised model to predict best FlowSOM parameters (XDIM, YDIM, RLEN)
from ddPCR data statistics collected in meta_dataset.csv.

Each row in meta_dataset.csv corresponds to one plate / dataset that was
previously optimised with optimize_flowsom_params.py.

Outputs (saved next to this script):
  param_predictor.pkl          – trained model (RandomForest, multi-output)
  param_predictor_report.txt   – cross-validation scores and feature importances

Install once:
    pip install scikit-learn joblib
"""
from __future__ import annotations

import os

import joblib
import numpy as np
import pandas as pd
from sklearn.ensemble import RandomForestClassifier, RandomForestRegressor
from sklearn.model_selection import cross_validate, LeaveOneOut, cross_val_predict
from sklearn.multioutput import MultiOutputRegressor
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler

# ── Config ─────────────────────────────────────────────────────────────────────
HERE          = os.path.dirname(__file__)
META_CSV      = os.path.join(HERE, "output", "meta_dataset.csv")
MODEL_OUT     = os.path.join(HERE, "param_predictor.pkl")
REPORT_OUT    = os.path.join(HERE, "param_predictor_report.txt")
MIN_SAMPLES   = 5   # warn if fewer rows (model will be unreliable)

CLUSTER_COL   = "best_n_clusters"
GRID_COLS     = ["best_xdim", "best_ydim", "best_rlen"]
TARGET_COLS   = [CLUSTER_COL] + GRID_COLS
DROP_COLS     = ["dataset", "metric", "best_silhouette", "clear_clustering", "mut_found"] + TARGET_COLS

# ── Load meta-dataset ──────────────────────────────────────────────────────────
if not os.path.exists(META_CSV):
    raise FileNotFoundError(
        f"{META_CSV} not found.\n"
        "Run optimize_flowsom_params.py on several datasets first."
    )

df = pd.read_csv(META_CSV)
print(f"Loaded meta_dataset.csv: {len(df)} rows, {df.shape[1]} columns.")

if len(df) < MIN_SAMPLES:
    print(
        f"\nWARNING: only {len(df)} sample(s). Model may overfit badly.\n"
        f"Collect at least {MIN_SAMPLES} datasets before trusting predictions."
    )

feature_cols = [c for c in df.columns if c not in DROP_COLS]

# best_n_clusters is defined for every row (including single-cluster wells), so
# it is trained on the full dataset. XDIM/YDIM/RLEN are only defined when a grid
# was actually optimised (best_n_clusters > 1), so that model uses the subset
# of rows with non-missing grid targets.
X_all     = df[feature_cols].values.astype(np.float64)
y_cluster = df[CLUSTER_COL].values.astype(int)

df_grid   = df.dropna(subset=GRID_COLS).reset_index(drop=True)
n_dropped = len(df) - len(df_grid)
if n_dropped:
    print(f"{n_dropped} row(s) have no grid targets (single-cluster wells); "
          "excluded from the XDIM/YDIM/RLEN model only.")
X_grid    = df_grid[feature_cols].values.astype(np.float64)
y_grid    = df_grid[GRID_COLS].values.astype(np.float64)

print(f"Features ({len(feature_cols)}): {feature_cols}")
print(f"Cluster target : {CLUSTER_COL}  ({len(df)} rows)")
print(f"Grid targets   : {GRID_COLS}  ({len(df_grid)} rows)\n")

# ── Models ─────────────────────────────────────────────────────────────────────
#  RandomForest handles non-linearities well and gives feature importances.
cluster_pipeline = Pipeline([
    ("scaler", StandardScaler()),
    ("model",  RandomForestClassifier(
        n_estimators=300,
        max_features="sqrt",
        min_samples_leaf=1,
        random_state=42,
        n_jobs=-1,
    )),
])

grid_base_rf = RandomForestRegressor(
    n_estimators=300,
    max_features="sqrt",
    min_samples_leaf=1,
    random_state=42,
    n_jobs=-1,
)
grid_pipeline = Pipeline([
    ("scaler", StandardScaler()),
    ("model",  MultiOutputRegressor(grid_base_rf, n_jobs=1)),
])

# ── Cross-validation ──────────────────────────────────────────────────────────
# Use LeaveOneOut when data are scarce, else 5-fold.
cluster_cv = LeaveOneOut() if len(df) <= 20 else 5
grid_cv    = LeaveOneOut() if len(df_grid) <= 20 else 5

print(f"Cross-validating cluster model ({cluster_cv} folds) …")
cluster_cv_results = cross_validate(
    cluster_pipeline, X_all, y_cluster,
    cv=cluster_cv,
    scoring="accuracy",
    return_train_score=True,
)
cluster_acc = cluster_cv_results["test_score"].mean()
print(f"CV accuracy (best_n_clusters): {cluster_acc:.3f}")

print(f"Cross-validating grid model ({grid_cv} folds) …")
grid_cv_results = cross_validate(
    grid_pipeline, X_grid, y_grid,
    cv=grid_cv,
    scoring="neg_mean_absolute_error",
    return_train_score=True,
)
mean_mae = -grid_cv_results["test_score"].mean()
std_mae  = grid_cv_results["test_score"].std()
print(f"CV MAE (avg across XDIM/YDIM/RLEN): {mean_mae:.3f} ± {std_mae:.3f}")
print("  (MAE is in the same units as the targets: grid steps for XDIM/YDIM, iterations for RLEN)")

# ── Train on full data ────────────────────────────────────────────────────────
cluster_pipeline.fit(X_all, y_cluster)
grid_pipeline.fit(X_grid, y_grid)

# ── Feature importances (averaged across sub-estimators) ──────────────────────
cluster_importances = cluster_pipeline.named_steps["model"].feature_importances_
grid_importances = np.mean(
    [est.feature_importances_ for est in grid_pipeline.named_steps["model"].estimators_],
    axis=0,
)
imp_df = pd.DataFrame({
    "feature": feature_cols,
    "cluster_importance": cluster_importances,
    "grid_importance": grid_importances,
})
imp_df = imp_df.sort_values("grid_importance", ascending=False).reset_index(drop=True)
print("\nTop-10 feature importances (grid model):")
print(imp_df.head(10).to_string(index=False))

# ── Save model ────────────────────────────────────────────────────────────────
joblib.dump(
    {
        "cluster_pipeline": cluster_pipeline,
        "grid_pipeline": grid_pipeline,
        "feature_cols": feature_cols,
    },
    MODEL_OUT,
)
print(f"\nModel saved → {MODEL_OUT}")

# ── Save report ───────────────────────────────────────────────────────────────
lines = [
    "FlowSOM Param Predictor – Training Report",
    "=" * 50,
    f"Training samples (cluster model) : {len(df)}",
    f"Training samples (grid model)    : {len(df_grid)}",
    f"Features                         : {len(feature_cols)}",
    f"Cluster CV strategy              : {cluster_cv}",
    f"Cluster CV accuracy              : {cluster_acc:.3f}",
    f"Grid CV strategy                 : {grid_cv}",
    f"Grid CV MAE (avg)                : {mean_mae:.3f} ± {std_mae:.3f}",
    "",
    "Per-target cross-validated predictions:",
]

# Reuse the same CV strategy as above (not a separate full leave-one-out re-fit,
# which is extremely slow here since each RandomForest already uses n_jobs=-1).
y_cluster_pred = cross_val_predict(cluster_pipeline, X_all, y_cluster, cv=cluster_cv)
cluster_acc_cv = float(np.mean(y_cluster_pred == y_cluster))
lines.append(f"  {CLUSTER_COL:<16}: accuracy = {cluster_acc_cv:.3f}")

y_grid_pred = cross_val_predict(grid_pipeline, X_grid, y_grid, cv=grid_cv)
for i, tgt in enumerate(GRID_COLS):
    mae_t = np.mean(np.abs(y_grid[:, i] - y_grid_pred[:, i]))
    lines.append(f"  {tgt:<16}: MAE = {mae_t:.2f}")

lines += [
    "",
    "Feature importances (grid model):",
]
lines += [f"  {row.feature:<30} {row.grid_importance:.4f}" for _, row in imp_df.iterrows()]

report_text = "\n".join(lines)
with open(REPORT_OUT, "w") as fh:
    fh.write(report_text)
print(f"Report saved  → {REPORT_OUT}")

